<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.slimcorp.muilive.WallpaperPreviewView
        android:id="@+id/fullscreenPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top floating bar -->
    <LinearLayout
        android:id="@+id/fullscreenTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/fullscreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="Интерактивный экран"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreenClose"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Закрыть"
            app:icon="@drawable/ic_check"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom floating bar -->
    <LinearLayout
        android:id="@+id/fullscreenBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreenDice"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="Новый seed"
            android:textColor="#FFFFFF"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_dice"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreenApply"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Установить"
            android:textColor="@color/on_accent_primary"
            app:backgroundTint="@color/accent_primary"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_wallpaper"
            app:iconTint="@color/on_accent_primary" />
    </LinearLayout>

</FrameLayout>
